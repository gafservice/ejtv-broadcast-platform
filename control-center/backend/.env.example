APP_NAME="EJTV Control Center"
ENVIRONMENT="development"
DEBUG=true

HOST="127.0.0.1"
PORT=8000

LOG_LEVEL="INFO"
LOG_DIRECTORY="../logs"

# SRT temporal Health policy.
# Configure both values together to enable stabilization.
# Validated policy: 10 s degradation confirmation, 5 s recovery.
STREAM_HEALTH_SRT_DEGRADATION_SECONDS=10
STREAM_HEALTH_SRT_RECOVERY_SECONDS=5

# Physical Media Health observation.
# MediaMTX RTSP output is resolved generically from each configured path.
MEDIA_OBSERVATION_RTSP_BASE_URL="rtsp://127.0.0.1:8554"
MEDIA_OBSERVATION_INTERVAL_SECONDS=5

# Media Health temporal stabilization policy.
MEDIA_HEALTH_DEGRADATION_SECONDS=10
MEDIA_HEALTH_RECOVERY_SECONDS=5

# Base local MaxMind GeoLite2 Country
GEOIP_DATABASE_PATH=data/geoip/GeoLite2-Country.mmdb

# NOC durable operational history
NOC_HISTORY_DATABASE_PATH=data/noc-history.db
NOC_EVIDENCE_PATH=data/noc-evidence
